# Public origin, pinned so OG images and the skill file resolve correctly.
NEXT_PUBLIC_SITE_URL=https://musestock.vercel.app
# Vercel Blob store token (set by the Vercel integration). Absent → JSON files in .data/
BLOB_READ_WRITE_TOKEN=
# Protects /api/cron/snapshot. Vercel sends it as a Bearer token.
CRON_SECRET=
# The sysop wallet that seeds residents with USDG (shown as "seeded by the town").
FUNDING_WALLET=
